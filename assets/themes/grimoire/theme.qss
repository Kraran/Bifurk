
            /* 9.75 pt = 13 px à 96 dpi ; conserver une taille en points valide pour la fenêtre Windows. */
            QMainWindow, QWidget { background-color: #241d18; color: #e9d6b3; font-family: '${ui_font}'; font-size: 10.5pt; }
            QMainWindow { background-image: url('${leather}'); }
            QLabel { background: transparent; }
            QLabel#appTitle { color: #edcb87; font-family: ${ui_font}; font-size: 29px; font-weight: bold; }
            QLabel#subtitle { color: #b89a68; font-size: 11px; letter-spacing: 2px; }
            QLabel#sectionTitle { color: #f0d39a; font-size: 25px; font-weight: bold; padding: 6px 2px; }
            QLabel#muted { color: #bca98b; }
            QWidget#readerPanel, QWidget#sidePanel { background: transparent; }
            QGroupBox { background-color: #30251d; border: 1px solid #79603b; border-radius: 7px;
                margin-top: 17px; padding: 13px 9px 9px; font-weight: bold; color: #e9c989; }
            QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 8px; background: #30251d; }
            QPushButton { background-color: #4a3527; color: #f1dcaf; border: 1px solid #9b7948;
                border-radius: 5px; padding: 9px 12px; font-family: ${ui_font}; font-weight: bold; }
            QPushButton:hover { background-color: #705038; border-color: #e1bc75; }
            QPushButton:pressed { background-color: #38291f; }
            QPushButton:disabled { color: #b3a283; border-color: #6a5a46; }
            QPushButton#goldButton { background-color: #a27a3f; color: #21170f; border: 1px solid #e0b975; }
            QPushButton#goldButton:hover { background-color: #c59a53; }
            QSpinBox, QLineEdit, QComboBox { background: #e6d0a5; color: #35251a; border: 1px solid #9d784b;
                border-radius: 4px; padding: 6px; selection-background-color: #9a723c; }
            QSpinBox::up-button, QSpinBox::down-button { width: 17px; }
            QListWidget { background-color: #e8d7b4; color: #3a291c; border: 1px solid #95744a;
                border-radius: 4px; padding: 4px; }
            QListWidget::item { padding: 4px; }
            QListWidget::item:selected { background: #a47a42; color: #fff4d8; }
            QTextBrowser#reader { background-color: #e8d0a2; background-image: url('${parchment}');
                color: #34251b; border: 5px double #806039; border-radius: 3px;
                padding: 28px 33px; font-family: "${reading_font}"; font-size: 20px; }
            QTextBrowser#reader QScrollBar { background: #cfb383; }
            QLabel#diceResult { color: #f6d58d; font-size: 19px; font-weight: bold; }
            QLabel#diceFaces { font-size: 43px; color: #e9cb8b; padding: 5px; }
            QLabel#equipment { background: #4b3727; color: #e8c88d; padding: 11px; border: 1px solid #987648; border-radius: 5px; }
            QLabel#initialStats { color: #c9b08a; font-size: 11px; }
            QLabel#combatState { background: #49301f; color: #f1d59b; padding: 9px; border: 1px solid #aa7b43; border-radius: 5px; }
            QListWidget#combatJournal { background: #d9c59e; color: #38271a; }

            QScrollArea#sideScroll { background: transparent; border: none; }
            QScrollBar:vertical { background: #30261f; width: 12px; margin: 0; }
            QScrollBar::handle:vertical { background: #82623d; border-radius: 5px; min-height: 30px; }
            QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
            QSplitter::handle { background: #79603b; width: 3px; }
            QDialog, QMessageBox, QFileDialog { background-color: #2b211a; color: #f1d9ac; }
            QDialog QLabel, QMessageBox QLabel, QFileDialog QLabel { color: #f0dbb6; background: transparent; }
            QDialog QPushButton, QMessageBox QPushButton { min-width: 85px; }
            QDialog QTextBrowser { background-color: #e8d0a2; background-image: url('${parchment}');
                color: #34251b; border: 3px double #806039; padding: 12px;
                font-family: '${reading_font}'; font-size: 17px; }
            QDialog QScrollArea { background: #2b211a; border: none; }
            QDialog QDialogButtonBox { background: transparent; }
            QFileDialog QTreeView, QFileDialog QListView, QFileDialog QTableView {
                background-color: #e8d0a2; color: #30241b;
                alternate-background-color: #dcc39a; selection-background-color: #967044;
                selection-color: #fff2d8; border: 1px solid #947143;
            }
            QFileDialog QHeaderView::section { background: #4a3527; color: #f1dcaf;
                border: 1px solid #9b7948; padding: 5px; }
            QFileDialog QLineEdit, QFileDialog QComboBox { background: #e8d0a2; color: #30241b;
                border: 1px solid #9b7948; padding: 5px; }
            QFileDialog QToolButton { background: #4a3527; color: #f1dcaf;
                border: 1px solid #9b7948; border-radius: 4px; padding: 5px; }
            QFileDialog QToolButton:hover { background: #705038; }
            QFileDialog QScrollBar:horizontal { background: #30261f; height: 12px; }
            QFileDialog QScrollBar::handle:horizontal { background: #82623d; border-radius: 5px; }
            QFileDialog QSplitter::handle { background: #79603b; }
            QDialog#illustrationDialog { background-color: #30231a; }
            QDialog QLabel#illustrationImage { background: #e8d0a2; border: 5px double #a37a43; padding: 4px; }
            QDialog QLabel#illustrationStatus { color: #cdb58b; font-size: 11px; }
            QMessageBox QLabel#qt_msgbox_label { color: #f0dbb6; font-size: 14px; }
            QMessageBox QLabel#qt_msgboxex_icon_label { background: transparent; }
        

QSpinBox#heroValue { background: #4e2925; color: #ffe4a7; border: 1px solid #a7804d;
    font-size: 28px; font-family: '${reading_font}'; padding: 5px; }
QSpinBox#heroValue QLineEdit { background: transparent; color: #ffe4a7; border: none; padding: 0; }
QScrollArea#pageScroll { background: transparent; border: none; }
QWidget#readerPanel { background: #ead9b8; border: 1px solid #b49360; border-radius: 9px; }
QWidget#sidePanel { background: #281b17; border: 1px solid #89653d; border-radius: 9px; }
QFrame#grimoireHeader { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #642a2e,stop:1 #35151c);
    border: 1px solid #b18a4e; border-bottom: 3px double #d6ad69; border-radius: 6px; }
QLabel#appTitle { font-family: '${reading_font}'; font-size: 31px; color: #ffe2a3; }
QLabel#sectionTitle { font-family: '${reading_font}'; color: #642a2e; font-size: 27px; }
QLabel#subtitle { color: #ddbd83; }
QLabel#bookName { color: #efd9b2; }
QTextBrowser#reader { background: #f6ecd6; background-image: none; color: #30241b;
    border: 1px solid #c9ac7c; border-left: 4px double #b49360; border-radius: 3px; padding: 18px 24px; }
QWidget#readerPanel QGroupBox { background: #f3e6ca; color: #642a2e;
    border: 1px solid #b49360; margin-top: 14px; padding-top: 12px; }
QWidget#readerPanel QGroupBox::title { background: #f3e6ca; color: #642a2e; }
QWidget#readerPanel QLabel { color: #4c3528; }
QWidget#readerPanel QPushButton { background: #e9d4ab; color: #442a1e; border: 1px solid #a67e45; }
QWidget#readerPanel QPushButton:hover { background: #fcecc9; border: 1px solid #71313a; }
QWidget#readerPanel QPushButton#choiceCard { text-align: left; padding: 13px 16px;
    border-left: 4px solid #843741; font-size: 17px; }
QWidget#readerPanel QPushButton#choiceCard QLabel#choiceCaption { font-size: 17px; color: #3a2418; }
QPushButton:focus { border: 2px solid #efc568; }
QWidget#readerPanel QPushButton:focus { border: 2px solid #74313a; }
QWidget#readerPanel QPushButton:disabled { color: #75644f; border-color: #b8a98d; }
QTabWidget#adventureTabs::pane { border: 1px solid #87633b; background: #30211a; border-radius: 4px; }
QTabBar::tab { background: #35231d; color: #cbb18b; padding: 10px 12px; border: 1px solid #795536; }
QTabBar::tab:selected { background: #6c2f36; color: #ffe7b1; border-bottom: 2px solid #d9b16b; }
QTabBar::tab:hover { color: #fff0cb; background: #51312a; }
QLabel#heroCrest { background: #55262c; border: 3px double #d1ad69; border-radius: 30px;
    color: #f9dda0; font-size: 30px; min-width: 60px; min-height: 60px; }
QLabel#heroTitle { font-family: '${reading_font}'; font-size: 23px; color: #f6d99f; }
QListWidget#inventoryCards { background: #35251c; border: none; padding: 4px; }
QListWidget#inventoryCards::item { background: #eeddbc; color: #432d20; border: 1px solid #ad8953;
    border-radius: 5px; margin: 3px; padding: 12px; }
QListWidget#inventoryCards::item:selected { background: #76343c; color: #fff0cd; border-color: #e7bf78; }
QPushButton#combatButton { background: #7c303b; color: #fff0cd; padding: 15px; border: 2px solid #bd9154; }
QPushButton#combatButton:enabled:hover { background: #9a414d; }
/* La règle spécifique doit suivre le fond bordeaux pour rendre l'inactivité visible. */
QPushButton#combatButton:disabled { background: #3e3b38; color: #aaa39b;
    border: 2px solid #69635c; }


QGroupBox { margin-top: 22px; padding: 22px 10px 10px; }
QGroupBox::title { top: 3px; left: 14px; padding: 2px 8px; }
QWidget#readerPanel QGroupBox { margin-top: 22px; padding: 22px 10px 10px; }
QLabel#inventoryHeading { color: #f1d49a; padding: 6px 0 10px; font-weight: bold; }
QFrame#inventoryPanel { background: #30221a; border: none; }
QListWidget#inventoryCards { padding: 0; background: #30221a; }
QListWidget#inventoryCards::item { margin: 1px 0; padding: 4px 6px; border: 1px solid #8d6d44; }
QWidget#readerPanel { border: 4px double #a68149; border-radius: 2px; }
QTextBrowser#reader { border: none; background: #f5e8ce; padding: 12px 16px; }
QWidget#readerPanel QPushButton#choiceCard { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
    stop:0 #f9edce, stop:1 #dfc08c); border: 3px double #9d743c; border-left: 5px solid #823842; }
QWidget#readerPanel QPushButton#choiceCard:hover { background: #fff1c8; border-color: #6f2933; }
QSpinBox#heroValue { font-size: 24px; background: #55252c; border: 3px double #c6a064; }
QSpinBox#heroValue::up-button, QSpinBox#heroValue::down-button { width: 0; height: 0; border: none; }
QWidget#sidePanel QSpinBox { background: #422a23; color: #f9e2b2; border: 1px solid #a88652; }
QWidget#sidePanel QSpinBox QLineEdit { background: transparent; color: #f9e2b2; border: none; }
QWidget#sidePanel QComboBox { background: #422a23; color: #f9e2b2; padding: 7px; }
QTabBar::tab { padding: 12px 10px; }
QWidget#readerPanel { border-radius: 12px; }
QTextBrowser#reader { border-radius: 10px; }
QWidget#readerPanel QPushButton#choiceCard { border-radius: 8px; }
QFrame#inventoryPanel, QListWidget#inventoryCards { border-radius: 8px; }
QWidget#sidePanel QSpinBox, QWidget#sidePanel QComboBox { border-radius: 7px; }
QTabWidget#adventureTabs::pane { border-radius: 8px; }
QTabBar::tab { border-top-left-radius: 8px; border-top-right-radius: 8px; }
QTextBrowser#reader { background: transparent; }
QWidget#readerPanel QGroupBox { background: transparent; }
QDialog QLabel#saveHeading { color: #f0d39a; font-size: 22px; padding: 10px 0; }
QLabel#paragraphNumber { color: #67452c; font-size: 16px; background: transparent; }
QDialog QPushButton[saveSlot="true"] { font-size: 15px; padding: 10px; border-radius: 8px; }
QPushButton#aboutBrand { background: transparent; border: 1px solid transparent;
    border-radius: 7px; padding: 3px; min-width: 0; }
QPushButton#aboutBrand:hover, QPushButton#aboutBrand:focus { border-color: ${gold}; background: #4b2925; }
QDialog#aboutDialog { background-color: ${scene_background}; border: 1px solid ${frame}; border-radius: 14px; }
QFrame#aboutBody { background-color: ${scene_background}; border-top: 1px solid ${ornament};
    border-bottom: 1px solid ${ornament}; }
QDialog QLabel#aboutHeading { color: ${gold}; font-family: '${reading_font}'; font-size: 24px; font-weight: bold; }
QDialog QLabel#aboutAppName { color: ${gold}; font-family: '${reading_font}'; font-size: 36px; font-weight: bold; }
QDialog QLabel#aboutVersion, QDialog QLabel#aboutKey { color: ${ornament}; }
QDialog QLabel#aboutNote { background-color: ${icon_background}; color: ${page};
    border-radius: 8px; padding: 12px; font-size: 12px; }

/* Fenêtres secondaires : cuir, bandeaux et contrôles communs au grimoire. */
QDialog { background-image: url('${leather}'); }
QFrame#dialogHeading { background: ${icon_background}; border: 1px solid ${frame};
    border-bottom: 3px double ${gold}; border-radius: 9px; }
QDialog QLabel#dialogTitle { font-family: '${reading_font}'; font-size: 27px;
    font-weight: bold; color: ${gold}; padding: 0; }
QDialog QLabel#dialogSubtitle { color: ${page}; font-size: 13px; padding: 0; }
QDialog QPushButton[dialogAction="primary"] { background: ${gold}; color: ${ink};
    border: 1px solid ${frame}; border-radius: 6px; }
QDialog QPushButton[dialogAction="primary"]:enabled:hover { background: ${page}; border-color: ${gold}; }
QDialog QPushButton[dialogAction="primary"]:disabled { background: ${scene_background}; color: ${ornament}; }
QDialog QPushButton[dialogAction="danger"] { background: ${icon_background}; color: ${page};
    border: 1px solid ${rubric}; min-width: 74px; }
QDialog QPushButton[dialogAction="danger"]:enabled:hover { background: ${rubric}; border-color: ${gold}; }
QDialog QPushButton[dialogAction="danger"]:disabled { background: ${scene_background}; color: ${ornament}; border-color: ${scene_background}; }
QDialog QPushButton:enabled:focus { border: 2px solid ${gold}; }
QDialog QScrollArea#saveSlotsScroll, QWidget#saveSlotsBody { background: transparent; border: none; }
QDialog QPushButton[saveSlot="true"] { background: ${page}; color: ${ink};
    border: 3px double ${frame}; border-left: 5px solid ${accent}; border-radius: 9px;
    text-align: left; font-size: 15px; padding: 10px 14px; }
QDialog QPushButton[saveSlot="true"]:enabled:hover { background: ${gold}; border-color: ${rubric}; }
QDialog QPushButton[emptySlot="true"] { font-size: 13px; padding: 6px 14px; font-style: italic; }
QDialog QPushButton[saveSlot="true"]:disabled { background: ${scene_background}; color: ${ornament}; border-color: ${frame}; }
QDialog QCheckBox { background: transparent; spacing: 10px; padding: 3px 0; }
QDialog QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid ${ornament};
    border-radius: 3px; background: ${page}; }
QDialog QCheckBox::indicator:checked { image: url('${checkmark}'); background: ${gold}; border-color: ${frame}; }
QDialog QCheckBox::indicator:hover { border: 2px solid ${gold}; }
QDialog QComboBox QAbstractItemView { background: ${page}; color: ${ink};
    selection-background-color: ${ornament}; selection-color: ${ink}; border: 1px solid ${frame}; padding: 4px; }
QMenu { background: ${scene_background}; color: ${page}; border: 1px solid ${frame}; padding: 4px 0; }
QMenu::item { padding: 8px 36px 8px 28px; border-radius: 4px; }
QMenu::item:selected { background: ${accent}; color: ${gold}; }
QMenu::item:disabled { color: ${ornament}; }
QMenu::indicator { width: 14px; height: 14px; margin-left: 8px; }
QMenu::right-arrow { width: 10px; height: 10px; margin-right: 10px; }
QMenu::separator { height: 1px; background: ${ornament}; margin: 5px 12px; }
QDialog QScrollBar:horizontal { background: ${scene_background}; height: 12px; margin: 0; }
QDialog QScrollBar::handle:horizontal { background: ${ornament}; min-width: 30px; border-radius: 5px; }
QDialog QScrollBar::add-line:horizontal, QDialog QScrollBar::sub-line:horizontal { width: 0; }
QMessageBox QLabel#qt_msgbox_label { font-size: 15px; }
QFileDialog QTreeView, QFileDialog QListView, QFileDialog QTableView { border-radius: 7px; padding: 4px; }
QFileDialog QToolButton { background: ${page}; border-color: ${frame}; }
QFileDialog QToolButton:hover { background: ${gold}; }
QSlider#musicVolume::groove:horizontal, QSlider#ttsVolume::groove:horizontal { height: 8px; background: ${scene_background};
    border: 2px solid ${ornament}; border-radius: 2px; }
QSlider#musicVolume::sub-page:horizontal, QSlider#ttsVolume::sub-page:horizontal { background: ${ornament}; }
QSlider#musicVolume::handle:horizontal, QSlider#ttsVolume::handle:horizontal { width: 16px; margin: -7px 0;
    background: ${gold}; border: 2px solid ${frame}; border-radius: 2px; }
QSlider#musicVolume::handle:horizontal:hover, QSlider#ttsVolume::handle:horizontal:hover, QSlider#musicVolume::handle:horizontal:focus, QSlider#ttsVolume::handle:horizontal:focus {
    background: ${page}; border-color: ${gold}; }

/* Proposition UI : en-tête allégé, sacoche repliable, ressources en lecture seule. */
QPushButton#settingsButton { font-size: 18px; padding: 4px 12px; }
QPushButton#settingsButton::menu-indicator { width: 0; image: none; }
QPushButton#inventoryToggle { text-align: left; color: #f1d49a; font-weight: bold;
    background: #30221a; border: 1px solid #87633b; padding: 6px 10px; }
QPushButton#inventoryToggle:checked { background: #3a291f; }
QWidget#sidePanel QSpinBox#resourceValue { background: #2c1f18; border: 1px solid #5e4630;
    color: #f6d99f; font-weight: bold; padding: 2px 6px; }
QWidget#sidePanel QSpinBox#resourceValue[locked="true"]::up-button,
QWidget#sidePanel QSpinBox#resourceValue[locked="true"]::down-button { width: 0; height: 0; border: none; }
QWidget#sidePanel QSpinBox#resourceValue QLineEdit { background: transparent; color: #f6d99f; font-weight: bold; }
QLabel#heroCrest { border-radius: 22px; font-size: 22px; min-width: 44px; min-height: 44px; }
QLabel#heroTitle { font-size: 20px; }

/* ---- Fiche d'aventurier illustrée (adventurer_sheet.py) ----
   Le fond, les blasons, la barre de vie, les plaques et les sceaux sont peints au QPainter ;
   ces règles rendent transparents les widgets de données qu'ils habillent. */
QWidget#sidePanel { background: transparent; border: none; }
QWidget#sidePanel QWidget { background: transparent; }
QWidget#sidePanel QGroupBox#sheetStats { background: transparent; border: none; margin: 0; padding: 0; }
QWidget#sidePanel QLabel#heroTitle { font-family: '${reading_font}'; font-size: 19px; font-weight: bold;
    color: #f4dc9e; }
QWidget#sidePanel QSpinBox#heroValue { background: transparent; border: none; padding: 0;
    color: #fff3d6; font-family: '${reading_font}'; font-size: 34px; font-weight: bold; }
QWidget#sidePanel QSpinBox#heroValue::up-button,
QWidget#sidePanel QSpinBox#heroValue::down-button { width: 0; height: 0; border: none; }
QWidget#sidePanel QSpinBox#heroValue QLineEdit { background: transparent; border: none; color: #fff3d6; }
QWidget#sidePanel QSpinBox#heroValue:disabled, QWidget#sidePanel QSpinBox#heroValue QLineEdit:disabled { color: #b9a98f; }
QWidget#sidePanel QSpinBox#resourceValue { background: transparent; border: 1px solid transparent; border-radius: 5px;
    padding: 0; color: #f6d99f; font-family: '${reading_font}'; font-size: 27px; font-weight: bold; }
QWidget#sidePanel QSpinBox#resourceValue QLineEdit { background: transparent; border: none; color: #f6d99f;
    font-family: '${reading_font}'; font-size: 27px; font-weight: bold; }
QWidget#sidePanel QSpinBox#resourceValue[locked="false"] { border: 1px dashed #d8b46c; background: rgba(0, 0, 0, 70); }
QWidget#sidePanel QLabel#tokenValue { color: #f6d99f; font-family: '${reading_font}'; font-size: 22px; font-weight: bold; }
QWidget#sidePanel QPushButton#combatButton { color: #fff0cd; font-family: '${reading_font}'; font-size: 18px;
    font-weight: bold; letter-spacing: 2px; padding: 9px; border: 2px solid #d8b46c; border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #a83a48, stop:0.55 #7a2632, stop:1 #4a141c); }
QWidget#sidePanel QPushButton#combatButton:hover { border-color: #f4dc9e;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #c24a59, stop:0.55 #8e2e3b, stop:1 #57171f); }
QWidget#sidePanel QPushButton#sheetLink { background: transparent; border: none; color: #d8b46c;
    font-family: '${reading_font}'; font-style: italic; font-size: 14px; padding: 2px 6px; }
QWidget#sidePanel QPushButton#sheetLink:hover, QWidget#sidePanel QPushButton#sheetLink:checked { color: #f4dc9e; }
QWidget#sidePanel QLineEdit#sheetInput { background: #efdfbb; color: #30241b; border: 1px solid #ad8950;
    border-radius: 4px; padding: 4px 6px; font-family: '${reading_font}'; font-size: 15px; }
QWidget#sidePanel QComboBox#weaponBanner { color: #f4dc9e; border: 1px solid #d8b46c; border-radius: 4px;
    padding: 4px 10px; font-family: '${reading_font}'; font-size: 15px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #8a2a36, stop:1 #4a141c); }
QWidget#sidePanel QComboBox#weaponBanner QAbstractItemView { background: #3a1a16; color: #f4dc9e;
    selection-background-color: #7a2632; border: 1px solid #d8b46c; }
QWidget#sidePanel QCheckBox { color: #e9c989; font-family: '${reading_font}'; font-size: 15px; }
QWidget#sidePanel QTabWidget#adventureTabs::pane { border: none; background: transparent; }
QWidget#sidePanel QFrame#inventoryPanel { background: transparent; border: none; }
QWidget#sidePanel QListWidget#inventoryCards { background: transparent; border: none; padding: 0; }
QWidget#sidePanel QListWidget#inventoryCards::item { background: transparent; border: none; margin: 0; padding: 0; }
QWidget#sidePanel QScrollBar:vertical { background: rgba(0, 0, 0, 60); width: 8px; border-radius: 4px; margin: 0; }
QWidget#sidePanel QScrollBar::handle:vertical { background: #8a6633; border-radius: 4px; min-height: 24px; }
QWidget#sidePanel QScrollBar::add-line, QWidget#sidePanel QScrollBar::sub-line { height: 0; }
QScrollArea#sideScroll QScrollBar:vertical { background: #1c100c; width: 9px; }
QScrollArea#sideScroll QScrollBar::handle:vertical { background: #8a6633; border-radius: 4px; min-height: 24px; }
/* ---- Proposition v3 : centre en page de livre, bandeau de cuir et d'or. ----
   Les surfaces sont peintes (grimoire_chrome) ; ces règles neutralisent les boîtes grises. */
QFrame#grimoireHeader { background: transparent; border: none; }
QLabel#bookName { color: #f1dcae; font-family: 'EB Garamond'; font-size: 17px; font-style: italic; }
QWidget#readerPanel { background: transparent; border: none; }
QWidget#readerPanel QLabel#sectionTitle { font-family: 'EB Garamond'; color: #7a2632; font-size: 30px;
    font-weight: bold; letter-spacing: 1px; padding: 2px 2px 0; }
QTextBrowser#reader { background: transparent; border: none; padding: 4px 6px; color: #2e1d14; }
QScrollArea#pageScroll QScrollBar:vertical { background: #1c100c; width: 9px; }
QScrollArea#pageScroll QScrollBar::handle:vertical { background: #8a6633; border-radius: 4px; min-height: 24px; }
/* Après pageScroll : la barre du texte, fine et bronze sur le vélin. */
QTextBrowser#reader QScrollBar:vertical { background: rgba(120, 80, 30, 35); width: 7px;
    border: none; border-radius: 3px; margin: 2px 0; }
QTextBrowser#reader QScrollBar::handle:vertical { background: #a0773f; border-radius: 3px; min-height: 26px; }
QTextBrowser#reader QScrollBar::add-line:vertical, QTextBrowser#reader QScrollBar::sub-line:vertical { height: 0; }
QTextBrowser#reader QScrollBar::add-page:vertical, QTextBrowser#reader QScrollBar::sub-page:vertical { background: none; }
QWidget#readerPanel QGroupBox { background: transparent; border: none; margin: 0; padding: 0; }
QWidget#readerPanel QGroupBox::title { color: transparent; background: transparent; padding: 0; }
QWidget#readerPanel QLabel { color: #4a3122; font-family: 'EB Garamond'; font-size: 17px; }
QWidget#readerPanel QLabel#fontSizeLabel { color: #7a2632; font-family: 'Lato'; font-size: 12px; font-weight: bold; }
/* Boutons d'événement (tests, combats, objets) : plaques de parchemin à filet d'or. */
QWidget#readerPanel QPushButton { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #fbf1d8, stop:1 #e6cb96);
    color: #3a2418; border: 2px solid #a5783c; border-radius: 8px; padding: 9px 16px;
    font-family: 'EB Garamond'; font-size: 17px; font-weight: bold; }
QWidget#readerPanel QPushButton:hover { background: qlineargradient(x1:0,y1:0,x2:0,y2:1, stop:0 #fffaea, stop:1 #f3dca9);
    border-color: #7a2632; }
QWidget#readerPanel QPushButton:focus { border: 2px solid #7a2632; }
QWidget#readerPanel QPushButton:disabled { color: #8a7a64; background: #e7dcc4; border-color: #c2b08c; }
QWidget#readerPanel QLineEdit, QWidget#readerPanel QComboBox { background: #fbf3df; color: #2e1d14;
    border: 1px solid #a5783c; border-radius: 6px; padding: 6px 8px; font-family: 'EB Garamond'; font-size: 17px; }
QPushButton#aboutBrand { border: 1px solid transparent; border-radius: 14px; background: transparent; }
QPushButton#aboutBrand:hover { background: rgba(255, 220, 150, 22); border-color: transparent; }
QPushButton#aboutBrand:focus { background: transparent; border: 1px dotted rgba(223, 191, 124, 110); }
QWidget#readerPanel QLabel#choiceCaption,
QWidget#readerPanel QPushButton#choiceCard QLabel#choiceCaption { font-family: 'EB Garamond'; font-size: 21px; color: #2e1d14; }
QWidget#readerPanel QPushButton:disabled QLabel#choiceCaption { color: #8a7a64; }
/* Cadre de messages : résultat de la dernière règle, sobre, comme une glose en marge. */
QWidget#readerPanel QLabel#messageFrame { background: #efdfbd; color: #4a2a1f;
    border: 1px solid #b49360; border-left: 4px solid #823842; border-radius: 6px;
    padding: 8px 12px; font-size: 15px; font-style: italic; }
/* Alerte d'Endurance basse : liseré or sur cire, sans clignotement. */
QWidget#readerPanel QFrame#enduranceAlert { background: #f1e0bb; border: 1px solid #a67e45;
    border-left: 4px solid #b8892f; border-radius: 6px; }
QWidget#readerPanel QLabel#enduranceAlertText { color: #642a2e; font-weight: bold; font-size: 15px; }
QWidget#readerPanel QPushButton#alertCare { background: #7c303b; color: #fff0cd;
    border: 2px solid #d8b46c; border-radius: 6px; padding: 6px 14px; font-weight: bold; }
QWidget#readerPanel QPushButton#alertCare:hover { background: #9a414d; }
